# ---------------------------------------------------------------------------
# Web app environment. Copy to .env.local and adjust for your setup.
#
# Only NEXT_PUBLIC_* vars are read here — everything else the app needs is
# server-side config on node-backend (see the root .env.example).
# ---------------------------------------------------------------------------

# Base URL the BROWSER uses to reach node-backend, for both REST calls and the
# Socket.IO connection (src/lib/api-client.ts, github.ts, socket-client.ts).
#
# Two consequences of the NEXT_PUBLIC_ prefix worth knowing:
#   1. It is inlined into the JS bundle at BUILD time, not read at runtime —
#      changing it requires a rebuild/redeploy, not just a restart.
#   2. It is public. Never put a secret behind this prefix.
#
# Must be reachable from the user's browser, so a Docker service name
# (http://node-backend:4000) will NOT work here — use the published host/port.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Shared infrastructure -------------------------------------------------
DATABASE_URL=postgresql://copilot:copilot@postgres:5432/ai_codebase_copilot  # Postgres connection string used by node-backend and ai-service
REDIS_URL=redis://redis:6379                                                 # Redis connection string used for caching/job queues
QDRANT_URL=http://qdrant:6333                                                # Qdrant vector DB endpoint used by ai-service for embeddings search
QDRANT_API_KEY=                                                              # Only needed for Qdrant Cloud; leave blank for local/docker Qdrant (no auth)

# --- Auth / security --------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string                                 # Secret used to sign/verify user JWTs issued by node-backend
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-string                    # Shared secret for authenticating internal calls between node-backend and ai-service
AI_SERVICE_URL=http://ai-service:8000                                        # Base URL node-backend's internalHttpClient uses to call ai-service
NODE_BACKEND_URL=http://node-backend:4000                                    # Base URL ai-service uses to call back into node-backend's /internal routes
ALLOWED_ORIGINS=http://localhost:3001                                        # Comma-separated list of origins node-backend's CORS policy allows (no wildcard)
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key                             # AES-256-GCM key node-backend uses to encrypt GitHub tokens at rest; generate with `openssl rand -base64 32`

# --- Third-party APIs --------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx                       # API key for Claude models, used by ai-service
GITHUB_CLIENT_ID=your-github-oauth-client-id                                 # GitHub OAuth App client ID, used for repo import / login
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret                        # GitHub OAuth App client secret, used for repo import / login
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback              # Must exactly match the callback URL registered on the GitHub OAuth App
FRONTEND_URL=http://localhost:3001                                           # Web app origin node-backend redirects back to after the GitHub OAuth flow
LANGSMITH_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxxxxxxx                          # LangSmith API key for tracing/observability of AI service chains
LANGSMITH_PROJECT=ai-codebase-copilot                                        # LangSmith project name traces are grouped under
LANGCHAIN_TRACING_V2=true                                                    # Enables LangChain/LangGraph tracing to LangSmith (read directly from the env by langchain, not just via Settings)

# --- Runtime ------------------------------------------------------------
NODE_ENV=development                                                         # Runtime mode shared by node-backend and web (development | production | test)

# --- Service ports ------------------------------------------------------
NODE_BACKEND_PORT=4000                                                       # Port the Express API server listens on
AI_SERVICE_PORT=8000                                                         # Port the FastAPI AI service listens on
WEB_PORT=3001                                                                 # Port the Next.js web app listens on

# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Shared infrastructure -------------------------------------------------
DATABASE_URL=postgresql://copilot:copilot@postgres:5432/ai_codebase_copilot  # Postgres connection string used by node-backend and ai-service
REDIS_URL=redis://redis:6379                                                 # Redis connection string used for caching/job queues
QDRANT_URL=http://qdrant:6333                                                # Qdrant vector DB endpoint used by ai-service for embeddings search

# --- Auth / security --------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string                                 # Secret used to sign/verify user JWTs issued by node-backend
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-string                    # Shared secret for authenticating internal calls between node-backend and ai-service

# --- Third-party APIs --------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx                       # API key for Claude models, used by ai-service
GITHUB_CLIENT_ID=your-github-oauth-client-id                                 # GitHub OAuth App client ID, used for repo import / login
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret                        # GitHub OAuth App client secret, used for repo import / login
LANGSMITH_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxxxxxxx                          # LangSmith API key for tracing/observability of AI service chains

# --- Runtime ------------------------------------------------------------
NODE_ENV=development                                                         # Runtime mode shared by node-backend and web (development | production | test)

# --- Service ports ------------------------------------------------------
NODE_BACKEND_PORT=4000                                                       # Port the Express API server listens on
AI_SERVICE_PORT=8000                                                         # Port the FastAPI AI service listens on
WEB_PORT=3000                                                                 # Port the Next.js web app listens on
